# Swift Package Manager build output
.build/
.swiftpm/
Packages/
Package.pins

# Xcode project — generated by xcodegen from App/project.yml.
# Run `xcodegen` inside ios/App/ to materialize the .xcodeproj on a fresh clone.
# Source of truth lives in project.yml; the generated project is a build artifact.
*.xcodeproj/
*.xcworkspace/

# Info.plist for the App target is generated by xcodegen from inline
# properties in App/project.yml. Source of truth lives there.
App/AcornIOS/Info.plist

# Xcode user state (only commit shared schemes, never per-user state)
xcuserdata/
*.xcuserdatad/
DerivedData/
*.moved-aside

# Apple platform artifacts
*.dSYM.zip
*.dSYM

# macOS
.DS_Store

# Local fastlane / signing / TestFlight scratch
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Coverage
*.profraw
*.profdata
