{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acorn",
  "version": "1.0.0",
  "identifier": "app.acorn.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Acorn",
        "width": 880,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "quick",
        "title": "Acorn Quick",
        "url": "quick.html",
        "width": 640,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true,
        "resizable": false,
        "shadow": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Stash your day, one acorn at a time.",
    "longDescription": "Acorn is a warm, AI-powered desktop companion that turns a messy day into focused task cards and walks you through them, one at a time.",
    "copyright": "Copyright © 2026 Acorn Contributors",
    "publisher": "Acorn Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
